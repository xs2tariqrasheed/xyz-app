# Copy to `.env` (which is git-ignored) and drop your key in.
#
# Enable these three APIs on the key in the Google Cloud console:
#   - Places API (New)   → address autocomplete
#   - Routes API         → the driving path between pickup and destination
#   - Maps Static API    → the rendered map image with the route drawn on it
#
# Restrict the key by API, and by HTTP referrer (web) / bundle ID + package
# name (iOS, Android). EXPO_PUBLIC_ values are readable inside the shipped app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
