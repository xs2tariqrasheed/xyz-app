# Copy to `.env` (which is git-ignored) and drop your key in.
#
# Enable these APIs on the key in the Google Cloud console:
#   - Places API              → address search + place details (legacy
#                               place/autocomplete/json and place/details/json
#                               on iOS / Android)
#   - Directions API          → the driving route between pickup and destination
#                               (directions/json on iOS / Android)
#   - Maps JavaScript API     → Places search, directions and the zoomable
#                               route map in the web build (those web services
#                               send no CORS headers)
#   - Maps SDK for Android / Maps SDK for iOS
#                             → the zoomable route map in native builds
#                               (react-native-maps; app.config.ts passes this
#                               key in — Expo Go uses its own)
#   - Geocoding API           → the car's street address on Track your route
#
# Restrict the key by API, and by HTTP referrer (web) / bundle ID + package
# name (iOS, Android). EXPO_PUBLIC_ values are readable inside the shipped app.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# API gateway. EXPO_PUBLIC_ values ship in the app bundle in plain text.
EXPO_PUBLIC_DBAPI_URL=https://elite-dbapi-gatekeeper.vercel.app/DBAPI/ProcessRequest
EXPO_PUBLIC_DBAPI_SOURCE=XYZWebApp
EXPO_PUBLIC_DBAPI_TARGET=XYZAPI
EXPO_PUBLIC_DBAPI_LOGIN=xyzapp@xyz.com

# Sent as JHeader.APIPassword. Set the real value in .env only.
EXPO_PUBLIC_DBAPI_PASSWORD=

# Hours a login stays valid on this device (default 720 = 30 days).
EXPO_PUBLIC_AUTH_SESSION_MAX_AGE_HOURS=720

# Optional JHeader values (docs/XYZ_INTEGRATION_GUIDE.md §3). Unset ones are sent empty;
# CLIENT_VERSION falls back to the app version in app.json.
EXPO_PUBLIC_DBAPI_CLIENT=XYZ
EXPO_PUBLIC_DBAPI_CLIENT_VERSION=1.0.0
EXPO_PUBLIC_DBAPI_API_VERSION=1.0.1
EXPO_PUBLIC_DBAPI_REQUESTED_URL=http://domain.com/WebAPI/ProcessRequest

# JHeader GPS when neither the request nor the device has a position.
EXPO_PUBLIC_JHEADER_FALLBACK_LAT=0
EXPO_PUBLIC_JHEADER_FALLBACK_LNG=0

# Public-IP service for JHeader ClientIP (JSON {"ip": ...} or plain text).
# Every user's IP is visible to this service. Unset sends "0.0.0.0".
EXPO_PUBLIC_CLIENT_IP_LOOKUP_URL=https://api.ipify.org?format=json

# The live "Rate a ride" form. Completed rides link here with ?rideno=<ride>
# until the gateway has a rating code. Unset hides the feedback link.
EXPO_PUBLIC_RATE_A_RIDE_URL=https://www.xyzcar.com/rate-a-ride/

# Google reCAPTCHA v2 ("I'm not a robot" Checkbox) on login, password reset and
# registration. Create the key pair at https://www.google.com/recaptcha/admin
# and list every host the widget runs on: localhost (web dev), the Vercel
# domain, and the host of EXPO_PUBLIC_RECAPTCHA_VERIFY_URL (iOS / Android load
# the widget with that origin as their base URL).
#
# Public site key — it ships in the app bundle, which is expected.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
# Absolute URL of api/verify-recaptcha.ts on the Vercel deploy, e.g.
# https://<your-vercel-domain>/api/verify-recaptcha
# For local development use http://localhost:3009/api/verify-recaptcha —
# `npm start` / `npm run web` / `ios` / `android` serve it alongside Expo
# (`npm run recaptcha:dev` runs it on its own). Left empty, the check shows
# "Verification is unavailable" instead of the checkbox. Restart the Expo
# server after changing it (values are baked into the bundle).
EXPO_PUBLIC_RECAPTCHA_VERIFY_URL=

# Server-only (no EXPO_PUBLIC_ prefix, never bundled). Read by
# api/verify-recaptcha.ts — set them in the Vercel project's Environment
# Variables too; this file only feeds `vercel dev`.
RECAPTCHA_SECRET_KEY=
# Optional comma list of hostnames Google must report the widget was solved on.
RECAPTCHA_ALLOWED_HOSTNAMES=
