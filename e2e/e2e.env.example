# Copy to `e2e/e2e.local.env` (git-ignored) for `npm run test:e2e`.
#
# Test account only. The gateway checks these credentials for real
# (PROF.S.CHECK_LOGIN_CREDENTIALS), so use a login the backend has issued for
# testing. Never commit it — this file's copy stays a placeholder.
E2E_LOGIN_EMAIL=test@example.com
E2E_LOGIN_PASSWORD=

# Where the app is served during the run (the Expo web dev server).
E2E_BASE_URL=http://localhost:8081

# Google's published reCAPTCHA v2 test site key: its checkbox always passes and
# shows a "for testing purposes only" banner. Loaded before the app's `.env`, so
# the Expo server started for the run picks it up (stop any dev server that is
# already running with the real key first). The verify call is answered by the
# tests themselves; this URL is only what they intercept.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
EXPO_PUBLIC_RECAPTCHA_VERIFY_URL=https://recaptcha-verify.test/api/verify-recaptcha
